      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const websiteId = $('Execute Workflow Trigger').first().json.Website_ID || '';\nconst domain = $('Execute Workflow Trigger').first().json.Domain || '';\n\nconst out = [];\nfor (const item of $input.all()) {\n  const resp = item.json || {};\n  const rows = Array.isArray(resp.rows) ? resp.rows : [];\n  for (const r of rows) {\n    const date = Array.isArray(r.keys) && r.keys.length ? r.keys[0] : '';\n    out.push({\n      json: {\n        Website_ID: websiteId,\n        Domain: domain,\n        Date: date,\n        Clicks: Number(r.clicks || 0),\n        Impressions: Number(r.impressions || 0),\n        CTR: Number(r.ctr || 0),\n        Position: Number(r.position || 0),\n      },\n    });\n  }\n}\n\nreturn out;"
      },
