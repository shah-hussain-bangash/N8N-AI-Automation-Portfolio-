    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0) {\n  throw new Error('هیچ موضوع \"not_used\" ای توی شیت پیدا نشد. باید ورک‌فلوی تولید ایده رو اجرا کنی.');\n}\n\n// انتخاب رندوم یکی از بین موضوعات موجود\nconst randomIndex = Math.floor(Math.random() * items.length);\nconst selected = items[randomIndex].json;\n\nreturn [{\n  json: selected\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        576,
        -256
      ],
      "id": "828b2c67-714a-4592-aa16-2ea7699c39e3",
      "name": "Choose one topic"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-2.5-flash",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "=You are the content manager for Lucky Lion Games, a board game design studio,\nwriting a LinkedIn post for the company's official page.\n\nSTRICT RULE: Write the entire response only in English, regardless of the\nlanguage of the topic or notes below. Never use Persian or any other language.\n\nTone: professional but warm, focused on educational value for the board game\ncommunity — not direct self-promotion.\n\nRules:\n- Length: between 180 and 280 words (do not go under 180 words)\n- Hook instruction for the opening line: {{ $json.hookInstruction }}\n- STRICTLY DO NOT start the post with \"Ever felt\", \"Have you ever\", \"Imagine\",\n  or any generic rhetorical question pattern, unless explicitly instructed above.\n- End with 2-3 relevant English hashtags\n\n\nPillar: {{ $json.pillar }}\nTopic: {{ $json.topic }}\nSource notes (if any): {{ $json.source_notes }}\n\nReturn the output strictly as JSON, no Markdown, no extra explanation, in\nexactly this format:\n{\n  \"post\": \"the full post text here\",\n  \"imageQuery\": \"2-3 simple English words for a stock photo search related to the topic\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "temperature": 0.8
        }
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        960,
        -256
      ],
      "id": "fda31555-da8d-4faf-8548-321ba035dc9a",
      "name": "Message a model"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst raw = data.content?.parts?.[0]?.text;\n\nif (typeof raw !== 'string') {\n  throw new Error('متن پیدا نشد: ' + JSON.stringify(data));\n}\n\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('پارس JSON شکست خورد: ' + cleaned);\n}\n\nconst original = $('Choose one topic').first().json; // اسم node انتخاب موضوع رو دقیق بذار\n\nreturn [{\n  json: {\n    draftText: parsed.post.trim(),\n    imageQuery: parsed.imageQuery.trim(),\n    id: original.id,\n    pillar: original.pillar,\n    topic: original.topic\n  }\n}];"
      },
