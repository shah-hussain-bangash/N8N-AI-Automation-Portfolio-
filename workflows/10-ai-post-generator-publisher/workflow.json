      "name": "Create a post"
    },
    {
      "parameters": {
        "jsCode": "const results = $input.first().json.results;\n\nconst staticData = $getWorkflowStaticData('global');\nstaticData.usedPhotoIds = staticData.usedPhotoIds || [];\n\n// عکس پیش‌فرض امن، برای وقتی که هیچ نتیجه‌ای پیدا نشد\nconst fallbackPhoto = {\n  id: 'fallback',\n  urls: { regular: 'https://images.unsplash.com/photo-1610890716171-6b1bb98ffd09' },\n  user: { name: 'Unsplash', links: { html: 'https://unsplash.com' } }\n};\n\nlet available = (results || []).filter(p => !staticData.usedPhotoIds.includes(p.id));\n\nif (available.length === 0 && results && results.length > 0) {\n  // همه قبلاً استفاده شدن، برگرد به کل لیست\n  available = results;\n}\n\nconst photo = available.length > 0 ? available[Math.floor(Math.random() * available.length)] : fallbackPhoto;\n\nif (photo.id !== 'fallback') {\n  staticData.usedPhotoIds.push(photo.id);\n  if (staticData.usedPhotoIds.length > 40) {\n    staticData.usedPhotoIds.shift();\n  }\n}\n\nreturn [{\n  json: {\n    imageUrl: photo.urls.regular,\n    downloadLocation: photo.links ? photo.links.download_location : null,\n    photographerName: photo.user.name,\n    photographerLink: photo.user.links.html\n  }\n}];"
      },
