    {
      "parameters": {
        "jsCode": "const hookStyles = [\n  \"Start with a bold, slightly contrarian statement that challenges a common assumption.\",\n  \"Start with a short, punchy one-line confession or observation from a designer's perspective.\",\n  \"Start with a surprising fact or number related to the topic.\",\n  \"Start with a vivid, specific mini-scene or moment (no more than one sentence).\",\n  \"Start with a direct, provocative question that is NOT phrased as 'Ever felt...' or 'Have you ever...'.\",\n  \"Start by naming a common mistake or myth directly, without any question.\"\n];\n\nconst randomStyle = hookStyles[Math.floor(Math.random() * hookStyles.length)];\n\nconst items = $input.all();\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    hookInstruction: randomStyle\n  }\n}));"
      },
