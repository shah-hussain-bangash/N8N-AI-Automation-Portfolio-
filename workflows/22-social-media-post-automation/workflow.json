    {
      "parameters": {
        "operation": "sendAndWait",
        "chatId": "REPLACE_WITH_CHATID_1",
        "message": "=📢 LINKEDIN POST APPROVAL\n\n📝 Topic: {{ $('Prepare LinkedIn Post').first().json.Topic }}\n📂 Category: {{ $('Prepare LinkedIn Post').first().json.Category }}\n\n━━━━━━━━━━━━━━━━━━━━\n\n{{ $('Prepare LinkedIn Post').first().json.GeneratedPost }}\n\n━━━━━━━━━━━━━━━━━━━━\n\nPlease review this LinkedIn post together with the image above.\n\n✅ Approve = Publish to LinkedIn\n❌ Reject = Generate a new version",
        "approvalOptions": {
          "values": {
            "approvalType": "double"
          }
        },
        "chatApproval": true,
        "options": {}
