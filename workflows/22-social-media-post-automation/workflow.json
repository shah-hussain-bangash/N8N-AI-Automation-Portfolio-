    {
      "parameters": {
        "jsCode": "const ai = $input.first().json;\nconst source = $('Limit1').first().json;\n\n// Extract only Claude's final text response.\n// Ignore the \"thinking\" content.\nconst generatedPostRaw =\n  Array.isArray(ai.content)\n    ? ai.content.find(item => item.type === 'text')?.text || ''\n    : '';\n\n// Convert literal \\n into real line breaks\nconst generatedPost = generatedPostRaw\n  .replace(/\\\\n/g, '\\n')\n  .trim();\n\n// Stop workflow if Claude did not return the final post\nif (!generatedPost) {\n  throw new Error(\n    'Claude did not return a final LinkedIn post. Check the Message a model node output.'\n  );\n}\n\nreturn [\n  {\n    json: {\n      row_number: source.row_number,\n      ID: source.ID,\n      Topic: source.Topic,\n      Category: source.Category,\n      Status: source.Status,\n      PublishDate: source['Publish Date'] || '',\n      GeneratedPost: generatedPost,\n      LinkedInURL: source['LinkedIn URL'] || ''\n    }\n  }\n];"
      },
