    {
      "parameters": {
        "jsCode": "const websiteId = $('Execute Workflow Trigger').first().json.Website_ID || '';\nconst domain = $('Execute Workflow Trigger').first().json.Domain || '';\nconst keyword = $('Execute Workflow Trigger').first().json.Keyword || '';\n\nfunction norm(u) {\n  return String(u || '').toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '');\n}\nconst target = norm(domain);\n\nconst resp = $input.first() ? $input.first().json : {};\nconst results = Array.isArray(resp.organic_results) ? resp.organic_results : [];\n\nlet position = null;\nfor (const r of results) {\n  const link = norm(r.link || r.displayed_link || '');\n  if (target && link.includes(target)) {\n    position = r.position != null ? Number(r.position) : null;\n    break;\n  }\n}\n\nreturn [{\n  json: {\n    Website_ID: websiteId,\n    Domain: domain,\n    Keyword: keyword,\n    Date: $today.toISODate(),\n    Position: position,\n    Found: position != null,\n    ok: true,\n  },\n}];"
      },
