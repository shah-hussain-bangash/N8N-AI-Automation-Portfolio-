    {
      "parameters": {
        "jsCode": "const websiteId = $('Execute Workflow Trigger').first().json.Website_ID || '';\nconst domain = $('Execute Workflow Trigger').first().json.Domain || '';\n\nfunction fmtDate(d) {\n  if (!d) return '';\n  const s = String(d);\n  // GA4 date dimension is YYYYMMDD -> YYYY-MM-DD\n  if (/^\\d{8}$/.test(s)) {\n    return s.slice(0, 4) + '-' + s.slice(4, 6) + '-' + s.slice(6, 8);\n  }\n  return s;\n}\n\nconst rows = $input.all().map((item) => {\n  const j = item.json || {};\n  return {\n    json: {\n      Website_ID: websiteId,\n      Domain: domain,\n      Date: fmtDate(j.date),\n      Sessions: Number(j.sessions || 0),\n      Users: Number(j.totalUsers || 0),\n      Views: Number(j.screenPageViews || 0),\n      Engaged_Sessions: Number(j.engagedSessions || 0),\n      Key_Events: Number(j.keyEvents || 0),\n    },\n  };\n});\n\nreturn rows;"
      },
