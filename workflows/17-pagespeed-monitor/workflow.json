      "id": "449ab6f9-63a5-4358-9d37-0a258121866e",
      "name": "PageSpeed Insights",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        448,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const websiteId = $('Execute Workflow Trigger').first().json.Website_ID || '';\nconst domain = $('Execute Workflow Trigger').first().json.Domain || '';\n\nconst resp = $input.first() ? $input.first().json : {};\nconst lr = resp.lighthouseResult || {};\nconst cats = lr.categories || {};\nconst perf = cats.performance || {};\nconst audits = lr.audits || {};\n\nconst score = perf.score != null ? Math.round(Number(perf.score) * 100) : null;\nconst fcp = audits['first-contentful-paint'] ? audits['first-contentful-paint'].displayValue : '';\nconst lcp = audits['largest-contentful-paint'] ? audits['largest-contentful-paint'].displayValue : '';\n\nreturn [{\n  json: {\n    Website_ID: websiteId,\n    Domain: domain,\n    Date: $today.toISODate(),\n    Performance_Score: score,\n    FCP: fcp,\n    LCP: lcp,\n    ok: score != null,\n  },\n}];"
      },
