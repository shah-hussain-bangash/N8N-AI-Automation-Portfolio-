    },
    {
      "parameters": {
        "jsCode": "const websiteId = $('Execute Workflow Trigger').first().json.Website_ID || '';\nconst domain = $('Execute Workflow Trigger').first().json.Domain || '';\n\nconst resp = $input.first() ? $input.first().json : {};\nlet code = Number(resp.statusCode || resp.status || 0);\n// If the request errored, n8n error output may not carry a status code\nconst up = code >= 200 && code < 400;\n\nreturn [{\n  json: {\n    Website_ID: websiteId,\n    Domain: domain,\n    status_code: code,\n    status: up ? 'Up' : 'Down',\n    ok: true,\n    message: up ? 'Site is up' : ('Site is down (HTTP ' + code + ')'),\n    checked_at: $now.toISO(),\n  },\n}];"
      },
