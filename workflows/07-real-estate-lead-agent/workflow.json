    {
      "parameters": {
        "promptType": "define",
        "text": "=Write a personalized email and a WhatsApp reply for this lead.\nName: {{ $('Lead Webhook').item.json.body.name }}\nLead Type: {{ $('AI Classification').item.json.output.leadType }}\nArea: {{ $('AI Classification').item.json.output.areaPreference }}\nBudget: {{ $('AI Classification').item.json.output.budget }}\nSentiment: {{ $('AI Classification').item.json.output.sentiment }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a real-estate sales assistant. Draft a warm, professional email (subject + body) and a concise WhatsApp reply personalized to the lead."
