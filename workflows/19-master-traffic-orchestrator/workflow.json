    {
      "parameters": {
        "jsCode": "let combined = [];\ntry {\n  combined = $('Combine Website Status').all();\n} catch (e) {\n  combined = [];\n}\nconst rows = combined\n  .map((i) => i.json || {})\n  .filter((j) => Object.keys(j).length > 0 && j.Website_ID);\n\nconst total = rows.length;\nconst downSites = rows.filter((r) => r.uptime_status === 'Down');\nconst errorSites = rows.filter((r) => (r.collectors_error || 0) > 0);\n\nconst alerts = [];\nfor (const r of downSites) {\n  alerts.push({ Website_ID: r.Website_ID, Domain: r.Domain, type: 'Uptime', severity: 'Critical', message: 'Site is DOWN' });\n}\nfor (const r of errorSites) {\n  alerts.push({ Website_ID: r.Website_ID, Domain: r.Domain, type: 'Collector', severity: 'Warning', message: (r.collectors_error) + ' collector(s) reported an issue' });\n}\n\nreturn [{\n  json: {\n    run_at: $now.toISO(),\n    websites_processed: total,\n    sites_down: downSites.length,\n    sites_with_errors: errorSites.length,\n    errors_count: alerts.length,\n    status: total === 0 ? 'No active websites' : (alerts.length === 0 ? 'Healthy' : 'Issues detected'),\n    alerts: alerts,\n  },\n}];"
      },
