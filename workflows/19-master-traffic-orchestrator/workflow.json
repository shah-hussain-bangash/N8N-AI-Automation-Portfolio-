    {
      "parameters": {
        "jsCode": "const loopItems = $('Loop Over Websites').all();\nconst ga4 = $('WF-02 GA4 Daily').all();\nconst gsc = $('WF-04 GSC Daily').all();\nconst up = $('WF-06 Uptime').all();\nconst ps = $('WF-07 PageSpeed').all();\nconst kw = $('WF-08 Keyword').all();\n\nfunction pick(arr, i) {\n  return arr && arr[i] ? (arr[i].json || {}) : {};\n}\n\nconst out = [];\nfor (let i = 0; i < loopItems.length; i++) {\n  const site = loopItems[i].json || {};\n  const uptime = pick(up, i);\n  const results = {\n    ga4: pick(ga4, i),\n    gsc: pick(gsc, i),\n    uptime: uptime,\n    pagespeed: pick(ps, i),\n    keyword: pick(kw, i),\n  };\n  const collectors = [results.ga4, results.gsc, results.uptime, results.pagespeed, results.keyword];\n  const errors = collectors.filter((c) => c && c.ok === false).length;\n  out.push({\n    json: {\n      Website_ID: site.Website_ID || '',\n      Domain: site.Domain || '',\n      uptime_status: uptime.status || 'Unknown',\n      collectors_ok: collectors.filter((c) => c && c.ok === true).length,\n      collectors_error: errors,\n      keyword_position: results.keyword.position != null ? results.keyword.position : null,\n      details: results,\n    },\n  });\n}\n\nreturn out;"
      },
